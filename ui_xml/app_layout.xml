<component>
  <styles>
    <!-- One shell, two orientations. The pair is bound complementarily on
         ui_is_portrait so exactly one is ever live, and flex_flow must NOT also
         appear inline on the view: an inline flex_flow is a local style and
         outranks every added style, which would pin the shell to one axis with
         nothing failing. -->
    <!-- Landscape: nav strip down the leading edge, content beside it. -->
    <style name="app_layout_landscape" flex_flow="row"/>
    <!-- Portrait: nav bar across the bottom, content above it. A reverse flow
         places children from the far end, so the navbar declared first lands at
         the bottom and one child order serves both orientations. -->
    <style name="app_layout_portrait" flex_flow="column_reverse"/>
  </styles>
  <!-- Main application layout: nav bar plus content area, on whichever axis the
       orientation asks for. style_layout is inline because a style block carries
       the flow alone: layout is a separate style property there, and without it
       the shell has no layout and every panel stacks at the content origin. -->
  <view extends="lv_obj"
        width="100%" height="100%" style_layout="flex" style_bg_opa="0%" style_border_width="0" style_pad_all="0"
        style_pad_column="0">
    <bind_style_if_eq name="app_layout_portrait" subject="ui_is_portrait" ref_value="1"/>
    <bind_style_if_not_eq name="app_layout_landscape" subject="ui_is_portrait" ref_value="1"/>
    <!-- Navigation bar: leading edge in landscape, bottom in portrait -->
    <navigation_bar name="navbar"/>
    <!-- Content area. flex_grow owns the shell's main axis in either flow, so
         each 100% only ever resolves on the cross axis. -->
    <lv_obj name="content_area"
            width="100%" height="100%" flex_grow="1" style_bg_opa="0%" style_pad_all="0" flex_flow="column">
      <!-- LCARS System header bar: joins the sidebar elbow with a concave inner curve -->
      <lv_obj name="lcars_header_24"
              width="100%" height="30" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_radius="0"
              style_layout="flex" flex_flow="row" style_pad_column="4" style_flex_cross_place="start"
              scrollable="false" clickable="false" hidden="true">
        <bind_flag_if cond="settings_lcars_system eq 1" flag="hidden" invert="true"/>
        <lv_obj width="150" height="30" style_bg_color="0xFF9900" style_bg_opa="255" style_border_width="0"
                style_radius="0" style_pad_all="0" scrollable="false" clickable="false">
          <lv_obj x="0" y="20" width="320" height="60" style_radius="12" style_bg_color="0x000000" style_bg_opa="255"
                  style_border_width="0" scrollable="false" clickable="false"/>
        </lv_obj>
        <lv_obj width="36" height="20" style_bg_color="0xCC99CC" style_bg_opa="255" style_border_width="0"
                style_radius="0" clickable="false"/>
        <lv_obj flex_grow="1" height="30" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_pad_right="2"
                style_layout="flex" flex_flow="row" scrollable="false" clickable="false">
          <lv_label text="HOME" flex_grow="1" style_text_align="right" style_text_color="0xFF9900" style_text_font="#font_body_bold" style_text_letter_space="1" hidden="true">
            <bind_flag_if cond="active_panel eq 0" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="PRINT FILES" flex_grow="1" style_text_align="right" style_text_color="0xFF9900" style_text_font="#font_body_bold" style_text_letter_space="1" hidden="true">
            <bind_flag_if cond="active_panel eq 1" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="CONTROLS" flex_grow="1" style_text_align="right" style_text_color="0xFF9900" style_text_font="#font_body_bold" style_text_letter_space="1" hidden="true">
            <bind_flag_if cond="active_panel eq 2" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="FILAMENT" flex_grow="1" style_text_align="right" style_text_color="0xFF9900" style_text_font="#font_body_bold" style_text_letter_space="1" hidden="true">
            <bind_flag_if cond="active_panel eq 3" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="SETTINGS" flex_grow="1" style_text_align="right" style_text_color="0xFF9900" style_text_font="#font_body_bold" style_text_letter_space="1" hidden="true">
            <bind_flag_if cond="active_panel eq 4" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="ADVANCED" flex_grow="1" style_text_align="right" style_text_color="0xFF9900" style_text_font="#font_body_bold" style_text_letter_space="1" hidden="true">
            <bind_flag_if cond="active_panel eq 5" flag="hidden" invert="true"/>
          </lv_label>
        </lv_obj>
        <lv_obj width="30" height="20" style_bg_color="0xFF9966" style_bg_opa="255" style_border_width="0"
                style_radius="10" clickable="false"/>
      </lv_obj>
      <lv_obj name="lcars_header_25"
              width="100%" height="20" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_radius="0"
              style_layout="flex" flex_flow="row" style_pad_column="4" style_flex_cross_place="start"
              scrollable="false" clickable="false" hidden="true">
        <bind_flag_if cond="settings_lcars_system eq 2" flag="hidden" invert="true"/>
        <lv_obj width="150" height="20" style_bg_color="0x5B7BA8" style_bg_opa="255" style_border_width="0"
                style_radius="0" style_pad_all="0" scrollable="false" clickable="false">
          <lv_obj x="0" y="8" width="320" height="60" style_radius="6" style_bg_color="0x05080F" style_bg_opa="255"
                  style_border_width="0" scrollable="false" clickable="false"/>
        </lv_obj>
        <lv_obj width="22" height="8" style_bg_color="0xF2A541" style_bg_opa="255" style_border_width="0"
                style_radius="0" clickable="false"/>
        <lv_obj width="8" height="8" style_bg_color="0x8FB3D9" style_bg_opa="255" style_border_width="0"
                style_radius="0" clickable="false"/>
        <lv_obj flex_grow="1" height="20" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_pad_right="6"
                style_layout="flex" flex_flow="row" scrollable="false" clickable="false">
          <lv_label text="HOME" flex_grow="1" style_text_align="right" style_text_color="0xB9D4F0" style_text_font="#font_small" style_text_letter_space="3" hidden="true">
            <bind_flag_if cond="active_panel eq 0" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="PRINT FILES" flex_grow="1" style_text_align="right" style_text_color="0xB9D4F0" style_text_font="#font_small" style_text_letter_space="3" hidden="true">
            <bind_flag_if cond="active_panel eq 1" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="CONTROLS" flex_grow="1" style_text_align="right" style_text_color="0xB9D4F0" style_text_font="#font_small" style_text_letter_space="3" hidden="true">
            <bind_flag_if cond="active_panel eq 2" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="FILAMENT" flex_grow="1" style_text_align="right" style_text_color="0xB9D4F0" style_text_font="#font_small" style_text_letter_space="3" hidden="true">
            <bind_flag_if cond="active_panel eq 3" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="SETTINGS" flex_grow="1" style_text_align="right" style_text_color="0xB9D4F0" style_text_font="#font_small" style_text_letter_space="3" hidden="true">
            <bind_flag_if cond="active_panel eq 4" flag="hidden" invert="true"/>
          </lv_label>
          <lv_label text="ADVANCED" flex_grow="1" style_text_align="right" style_text_color="0xB9D4F0" style_text_font="#font_small" style_text_letter_space="3" hidden="true">
            <bind_flag_if cond="active_panel eq 5" flag="hidden" invert="true"/>
          </lv_label>
        </lv_obj>
      </lv_obj>
      <bed_drying_banner name="bed_drying_banner"/>
      <!-- Panel container (grows to fill remaining space) -->
      <!-- All panels are stacked here, navigation controls visibility -->
      <lv_obj name="panel_container" width="100%" flex_grow="1" style_bg_opa="0%" style_pad_all="0">
        <!-- Panel 0: Home (visible by default) -->
        <home_panel name="home_panel"/>
        <!-- Panel 1: Print Select (hidden by default) -->
        <print_select_panel name="print_select_panel"/>
        <!-- Panel 2: Controls (hidden by default) -->
        <controls_panel name="controls_panel"/>
        <!-- Panel 3: Filament (hidden by default) -->
        <filament_panel name="filament_panel"/>
        <!-- Panel 4: Settings (hidden by default) -->
        <settings_panel name="settings_panel"/>
        <!-- Panel 5: Advanced (hidden by default) -->
        <advanced_panel name="advanced_panel"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
