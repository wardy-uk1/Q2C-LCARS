; SPDX-License-Identifier: GPL-3.0-or-later
; 16-bit stereo I2S output. One 32-bit FIFO word per frame, left sample in the
; high half. Side-set: bit 0 = BCLK (clock_pin_base), bit 1 = LRCLK (base + 1).
; Each bit takes 2 PIO cycles, so a frame is 64 cycles.
.program i2s_out
.side_set 2

bitloop1:
    out pins, 1       side 0b10
    jmp x-- bitloop1  side 0b11
    out pins, 1       side 0b00
    set x, 14         side 0b01

bitloop0:
    out pins, 1       side 0b00
    jmp x-- bitloop0  side 0b01
    out pins, 1       side 0b10
public entry_point:
    set x, 14         side 0b11

% c-sdk {
#include "hardware/clocks.h"

static inline void i2s_out_program_init(PIO pio, uint sm, uint offset, uint data_pin,
                                        uint clock_pin_base, uint sample_rate) {
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin_base);
    pio_gpio_init(pio, clock_pin_base + 1);

    pio_sm_config c = i2s_out_program_get_default_config(offset);
    sm_config_set_out_pins(&c, data_pin, 1);
    sm_config_set_sideset_pins(&c, clock_pin_base);
    sm_config_set_out_shift(&c, false, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &c);

    const uint pin_mask = (1u << data_pin) | (3u << clock_pin_base);
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
    pio_sm_set_pins(pio, sm, 0);

    // 64 PIO cycles per frame: divider = sys / (rate * 64), in 24.8 fixed point.
    const uint32_t divider = clock_get_hz(clk_sys) * 4u / sample_rate;
    pio_sm_set_clkdiv_int_frac(pio, sm, divider >> 8u, divider & 0xffu);

    pio_sm_exec(pio, sm, pio_encode_jmp(offset + i2s_out_offset_entry_point));
    pio_sm_set_enabled(pio, sm, true);
}
%}
